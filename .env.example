# ── CEEF WAF & Turnstile Solver Configuration ──
# Salin file ini menjadi `.env` lalu sesuaikan nilainya sesuai kebutuhan.

# ── 1. Konfigurasi Server Utama (Master WS Client) ──
# URL WebSocket server induk untuk mode distributed worker
MAIN_WS_URL=wss://api.myxzlyn.my.id/ws/cf-worker

# Token API Key / Secret (Disesuaikan dengan Secret di Dashboard https://api.myxzlyn.my.id/admin#cf-bypass)
WORKER_SECRET=default_cf_worker_secret_2026
# APIKEY=your_worker_secret_here

# Identitas Unik Worker (Otomatis dibuat jika dikosongkan)
# WORKER_ID=worker_sg_node1

# ── 2. Konfigurasi Port & Network ──
# Port server solver (Hugging Face default 7860, Pterodactyl menyesuaikan {{SERVER_PORT}})
PORT=7860
SERVER_PORT=7860

# ── 3. Kapasitas & Concurrency ──
# Batas jumlah sesi browser bersamaan (sesuaikan dengan RAM server)
# 2GB RAM → 10, 4GB RAM → 25, 8GB RAM → 50
browserLimit=20
MAX_CONCURRENT=20

# Batas waktu maksimal timeout solving per request (dalam milidetik)
timeOut=120000
SOLVER_TIMEOUT=120000

# ── 4. Keamanan Lokal (Opsional) ──
# Kunci rahasia wajib jika ingin mengamankan endpoint lokal POST /cf-clearance-scraper
# authToken=MyLocalSecretKey123

# ── 5. Jalur Chromium Kustom (Opsional) ──
# Biarkan kosong jika ingin sistem mendeteksi/mengunduh Chromium secara otomatis
# CHROME_BIN=/usr/bin/chromium
# CHROME_PATH=/usr/bin/chromium

# ── 6. Mode Operasi Latar Belakang ──
# Nonaktifkan peluncuran Chromium otomatis saat awal startup jika diperlukan
SKIP_LAUNCH=false
